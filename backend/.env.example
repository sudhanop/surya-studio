# Server
PORT=8080
APP_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database (SQL Server)
# Use port when SQL Browser is off: localhost,1433
# Or named instance if Browser is running: localhost\SQLEXPRESS or .\SQLEXPRESS
DB_SERVER=localhost,1433
DB_DATABASE=SuryaPhotography
DB_USER=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=true

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRY_HOURS=24

# Uploads
UPLOAD_DIR=../uploads
MAX_UPLOAD_MB=100
PUBLIC_MEDIA_URL=http://localhost:8080/uploads

# SMTP (optional — inquiry emails skipped if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@suryaphotography.com
ADMIN_EMAIL=admin@suryaphotography.com

# Contact page (public site)
WHATSAPP_NUMBER=919876543210
INSTAGRAM_URL=https://instagram.com/suryaphotography
FACEBOOK_URL=https://facebook.com/suryaphotography
YOUTUBE_URL=https://youtube.com/@suryaphotography
CONTACT_EMAIL=hello@suryaphotography.com
PHONE_NUMBER=+919876543210
GOOGLE_MAPS_EMBED=https://www.google.com/maps/embed?pb=
